# Variables de Tino Feria. Copiar a .env.feria (no se sube a git).
# La base, el puerto del backend y BACKEND_API_URL los fija docker-compose.feria.yml.

NODE_ENV=development

# Secreto nuevo, propio de la feria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-largo
# Sesiones largas: el stand no debería pedir login en todo el día.
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=30d

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PROXY_TIMEOUT_MS=15000

# Habilita el módulo demo (fase 1): sesión automática, reset, estado y WhatsApp simulado.
DEMO_MODE=true

# WhatsApp: valores ficticios. No se habla con Meta; en modo demo el cliente se reemplaza
# por uno que guarda los mensajes en memoria. El phone_number_id tiene que coincidir con
# el que arma POST /demo/whatsapp/inbound.
WHATSAPP_PHONE_NUMBER_ID=feria-demo
WHATSAPP_ACCESS_TOKEN=feria-demo
WHATSAPP_APP_SECRET=feria-demo
WHATSAPP_VERIFY_TOKEN=feria-demo
WHATSAPP_BUSINESS_NUMBER=

# Sin Google ni Trello: esas funciones quedan apagadas.

# Usuario demo (lo crea prisma/seed-feria.ts al levantar el backend). En la feria nadie lo
# tipea: la fase 1 suma POST /demo/session. Sirve para entrar a mano desde /login.
DEMO_USER_EMAIL=demo@tino-demo.local
DEMO_USER_PASSWORD=cambiar-por-una-clave
